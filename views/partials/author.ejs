<a href="/profile/<%= a.id %>" class="author"><span class="author__avatar"><%- avatarHtml(a, 28) %></span><span class="author__name<%= a.isSuper ? ' nick-super' : '' %>"><%= a.username %><% if (a.emoji) { %> <span class="nick-emoji"><%= a.emoji %></span><% } %></span></a><% if (a.roles && a.roles.admin) { %> <span class="badge badge--admin">Admin</span><% } %><% if (a.roles && a.roles.forumadmin) { %> <span class="badge badge--admin">Forum admin</span><% } %>