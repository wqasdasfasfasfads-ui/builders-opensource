# Copy this file to a file named ".env" (same folder) and fill it in.
# Never share the .env file with anyone.

# ---- Where reports (/help) are sent -----------------------------------
REPORT_TO=you@example.com

# ---- E-mail sender (SMTP) ---------------------------------------------
# Option A: Hotmail / Outlook (needs an APP PASSWORD, not your normal one)
SMTP_HOST=smtp-mail.outlook.com
SMTP_PORT=587
SMTP_USER=you@example.com
SMTP_PASS=put-your-app-password-here

# Option B: Gmail (easier). Replace the 4 lines above with:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=yourname@gmail.com
# SMTP_PASS=gmail-app-password   (Google account -> Security -> 2-Step -> App passwords)

# ---- PayPal (coin purchases) ------------------------------------------
# Get these at https://developer.paypal.com -> Apps & Credentials -> Create App.
# Start with sandbox (test money). For real money use live + live keys.
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=

# Public address of your site, no slash at the end. Needed so PayPal can send
# the buyer back to you. Example: https://my-site.example.com
# (leave empty to use the address from the browser, fine for local testing)
BASE_URL=http://localhost:3000

SESSION_SECRET=change-me-to-any-long-random-text
